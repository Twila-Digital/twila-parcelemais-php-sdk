{
    "name": "twila/parcelemais",
    "description": "SDK oficial em PHP para a API do Parcele+ (crédito direto ao consumidor e parcelamento no momento da compra)",
    "type": "library",
    "license": "MIT",
    "keywords": ["parcelemais", "cdc", "sdk", "twila"],
    "homepage": "https://github.com/Twila-Digital/twila-parcelemais-php-sdk",
    "authors": [
        {
            "name": "Twila Digital"
        }
    ],
    "support": {
        "issues": "https://github.com/Twila-Digital/twila-parcelemais-php-sdk/issues",
        "docs": "https://documentacao.parcelemais.com.br"
    },
    "require": {
        "php": "^7.4 || ^8.0",
        "guzzlehttp/guzzle": "^7.0",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5",
        "phpstan/phpstan": "^2.2",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "Twila\\ParceleMais\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Twila\\ParceleMais\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "cs": "phpcs"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
